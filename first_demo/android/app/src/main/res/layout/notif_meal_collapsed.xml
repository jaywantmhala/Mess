<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed meal reminder notification -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121315"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <!-- Left: text block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/meal_notif_icon_small"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/notif_tiffin_box"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/meal_notif_title_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Time for Lunch!"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/meal_notif_body_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap to order now"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Right thumbnail -->
    <ImageView
        android:id="@+id/meal_notif_thumb_small"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/notif_tiffin_box"
        android:scaleType="centerCrop"
        android:background="@drawable/notif_thumb_bg"
        android:clipToOutline="true" />

</LinearLayout>
